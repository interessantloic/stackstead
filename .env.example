# Compose deployment defaults. Copy to .env for local overrides.
COMPOSE_PROJECT_NAME=stackstead
STACKSTEAD_IMAGE=ghcr.io/interessantloic/stackstead:0.2.0
STACKSTEAD_PULL_POLICY=missing
# Used only when compose.build.yaml is explicitly included.
STACKSTEAD_BUILD_IMAGE=stackstead:dev
STACKSTEAD_BIND_ADDRESS=0.0.0.0
STACKSTEAD_HTTP_PORT=8080
STACKSTEAD_RESTART_POLICY=unless-stopped
PUID=1000
PGID=1000
TZ=UTC

# Used only by compose.bind.example.yaml / a local compose.override.yaml.
STACKSTEAD_DATA_PATH=./data

# Application runtime. Downloader and Bark credentials belong in the web UI.
STACKSTEAD_POLL_SECONDS=5
STACKSTEAD_SAMPLE_SECONDS=60
STACKSTEAD_SESSION_DAYS=30
STACKSTEAD_MAX_UPLOAD_BYTES=2097152
# Set to 1 only when the public URL is HTTPS.
STACKSTEAD_SECURE_COOKIES=0
STACKSTEAD_LOG_MAX_SIZE=10m
STACKSTEAD_LOG_MAX_FILES=3
